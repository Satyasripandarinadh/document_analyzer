# 🔹 Document summarization
def summarize_text_llm(text):
    model = genai.GenerativeModel("gemini-1.5-flash")
    prompt = f"Summarize the following document in simple terms:\n\n{text}"
    response = model.generate_content(prompt)
    return {"summary": response.text.strip()}

# 🔹 Resume analysis for HR
def extract_resume_data(text):
    model = genai.GenerativeModel("gemini-1.5-flash")
    prompt = f"""
    You are an AI HR assistant. Extract the following from this resume:
    - Name
    - Email
    - Skills
    - Education
    - CGPA or percentage
    - Projects
    - Experience (if any)
    - Suitable Job Role

    Then rate the candidate from 1 to 10 for software development fit.

    Resume Text:
    {text}
    """
    response = model.generate_content(prompt)
    return {"resume_analysis": response.text.strip()}
